{
  "identifier": "manager-local-only",
  "description": "Grant account management commands strictly to the local manager webview",
  "local": true,
  "windows": [
    "main",
    "manager"
  ],
  "webviews": [
    "manager"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manager-state",
    "allow-select-provider",
    "allow-add-account",
    "allow-rename-account",
    "allow-set-account-note",
    "allow-reorder-accounts",
    "allow-add-teleagent-account",
    "allow-update-teleagent-token",
    "allow-add-glados-account",
    "allow-update-glados-cookie",
    "allow-retry-account-view",
    "allow-refresh-all-quotas",
    "allow-remove-account",
    "allow-switch-account",
    "allow-set-modal-active",
    "allow-open-official-site",
    "allow-resolve-uuid-conflict",
    "allow-dismiss-notice",
    "allow-set-proxy-url",
    "allow-set-warm-view-limit",
    "allow-set-proxy-follow-system",
    "allow-trigger-quota-sync",
    "allow-check-for-updates",
    "allow-download-and-install-update",
    "allow-open-external-url",
    "allow-get-notification-status",
    "allow-send-test-notification",
    "allow-open-notification-settings",
    "allow-search-global-chats",
    "allow-open-global-chat"
  ]
}